<div class="show-container">
  <div class="content">
    <div class="information">
      <h1 class="m-0"><%= @restaurant.name %></h1>
      <%= link_to '< back to Restaurants', restaurants_path, class: 'btn-light opacity-25 text-decoration-none' %>
      <div class="card mb-4"></div>
      <p><strong>Address:</strong> <%= @restaurant.address %> </p>
      <p><strong>Phone number:</strong> <%= @restaurant.phone_number %> </p>
      <p><strong>Category:</strong> <%= @restaurant.category %> </p>
      <%= link_to "Add Review", new_restaurant_review_path(@restaurant), class: 'btn btn-primary mt-2' %>
    </div>
    <div class="rating">
      <h2> Ratings </h2>
      <% @restaurant.reviews.each do |review| %>
        <%= review.content %>
        <%= review.rating %>
      <% end %>
    </div>
  </div>
</div>
