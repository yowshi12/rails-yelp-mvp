<div class="container">
  <h1> Restaurants</h1>
  <div class="cards">
    <% @restaurants.each do |restaurant| %>
      <div class="card-product">
        <%= image_tag "restaurant#{rand(1..3)}.jpeg"%>
        <div class="card-product-infos">
          <h2><%= link_to restaurant.name, restaurant_path(restaurant) %></h2>
          <p><%= restaurant.address %></p>
          <p><%= restaurant.phone_number %></p>
          <p> <%= restaurant.category %></p>
          <p class="mb=1">Rating: <%= "⭐" * restaurant.avg_rating %></p>
        </div>
      </div>
    <% end %>
  </div>
  <%= link_to "Add New Restaurant", new_restaurant_path, class: 'btn btn-primary mt-2' %>
</div>
